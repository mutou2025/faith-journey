---
interface Props { value?: string; autofocus?: boolean; compact?: boolean }
const { value = '', autofocus = false, compact = false } = Astro.props;
---
<form class:list={['bible-search', { compact }]} action="/bible/search/" method="get" role="search" data-bible-search>
  <svg class="bs-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <input
    type="search"
    name="q"
    value={value}
    placeholder={compact ? "出处或关键词" : "约3:16、诗23 或关键词"}
    aria-label="查找经文"
    autocomplete="off"
    enterkeyhint="search"
    autofocus={autofocus}
  />
  <button type="submit">查找</button>
</form>

<script>
  import { parseRef, refHref } from '../../bible/ref';
  document.querySelectorAll<HTMLFormElement>('form[data-bible-search]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
      if (!q) { e.preventDefault(); return; }
      const ref = parseRef(q);
      if (ref) { e.preventDefault(); location.href = refHref(ref); }
    });
  });
</script>

<style>
  .bible-search {
    display: flex; align-items: center; gap: 8px; margin-top: 22px; padding: 6px 6px 6px 14px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px; box-shadow: var(--shadow);
  }
  .bible-search:focus-within { border-color: var(--accent); }
  .bs-icon { color: var(--muted); flex: none; }
  .bible-search input {
    flex: 1; min-width: 0; border: 0; background: none; color: var(--text); font: inherit; font-size: 1rem; padding: 6px 0; outline: none;
  }
  .bible-search input::-webkit-search-cancel-button { cursor: pointer; }
  .bible-search button {
    flex: none; border: 0; border-radius: 999px; background: var(--accent); color: #fff; font: inherit; font-weight: 600;
    font-size: 0.95rem; padding: 7px 16px; cursor: pointer;
  }
  .bible-search.compact { margin-top: 0; box-shadow: none; }
  .bible-search.compact input { font-size: 0.95rem; padding: 3px 0; }
  .bible-search.compact button { padding: 5px 13px; font-size: 0.88rem; }
  @media (max-width: 520px) {
    .bible-search input { font-size: 16px; }
  }
</style>
