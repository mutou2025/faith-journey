---
import type { CollectionEntry } from 'astro:content';
import { categoryByName } from '../consts';
import { formatDate } from '../lib';

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">这里还没有文章，敬请期待。</p>
) : (
  <ol class="timeline">
    {posts.map((p) => {
      const cat = categoryByName(p.data.category);
      return (
        <li>
          <div class="meta">
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <a class="chip" data-cat={cat.slug} href={`/category/${cat.slug}/`}>{cat.name}</a>
          </div>
          <h3><a href={`/posts/${p.id}/`}>{p.data.title}</a></h3>
          <p>{p.data.summary}</p>
        </li>
      );
    })}
  </ol>
)}
