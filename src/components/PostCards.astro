---
import type { CollectionEntry } from 'astro:content';
import { categoryByName } from '../consts';
import { formatDate } from '../lib';

interface Props {
  posts: CollectionEntry<'posts'>[];
  featureFirst?: boolean;
}
const { posts, featureFirst = false } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">这里还没有文章，敬请期待。</p>
) : (
  <div class="card-grid">
    {posts.map((p, i) => {
      const cat = categoryByName(p.data.category);
      return (
        <article class:list={['post-card', { featured: featureFirst && i === 0 }]}>
          <div class="meta">
            <a class="chip" data-cat={cat.slug} href={`/category/${cat.slug}/`}>{cat.name}</a>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          </div>
          <h3><a href={`/posts/${p.id}/`}>{p.data.title}</a></h3>
          <p>{p.data.summary}</p>
          {p.data.scriptures.length > 0 && (
            <div class="refs">{p.data.scriptures.map((s) => <span>{s}</span>)}</div>
          )}
        </article>
      );
    })}
  </div>
)}
