---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShareBox from '../../components/ShareBox.astro';
import { categoryByName, AUTHOR } from '../../consts';
import { getPosts, formatDate } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const cat = categoryByName(post.data.category);
const url = new URL(`/posts/${post.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.summary,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    inLanguage: 'zh-CN',
    url,
    mainEntityOfPage: url,
    image: new URL('/og.png', Astro.site).href,
    articleSection: cat.name,
    keywords: [cat.name, ...post.data.scriptures].join(','),
    author: { '@type': 'Person', name: AUTHOR },
    publisher: { '@type': 'Person', name: AUTHOR },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/category/${cat.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedTime={post.data.date}
  keywords={[cat.name, ...post.data.scriptures]}
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <div class="wrap">
      <div class="meta">
        <a class="chip" data-cat={cat.slug} href={`/category/${cat.slug}/`}>{cat.name}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.summary}</p>
      {post.data.scriptures.length > 0 && (
        <div class="refs">{post.data.scriptures.map((s) => <span>{s}</span>)}</div>
      )}
    </div>
  </header>
  <article class="wrap">
    <div class="prose">
      <Content />
    </div>
    <ShareBox />
    <nav class="post-nav" aria-label="上一篇和下一篇">
      <div>{older && <a href={`/posts/${older.id}/`}><small>← 较早</small>{older.data.title}</a>}</div>
      <div class="next">{newer && <a href={`/posts/${newer.id}/`}><small>较新 →</small>{newer.data.title}</a>}</div>
    </nav>
  </article>
</Base>
