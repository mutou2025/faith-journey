---
// 已隐藏：文件名以 _ 开头，Astro 不会生成这个页面。改回 journey.astro 即可恢复。
import Base from '../layouts/Base.astro';
import { JOURNEY } from '../journey';
---
<Base title="信仰历程" description="神一步一步带领我的脚踪：从异乡的孤单，到走进教会、受洗、服侍。">
  <header class="page-hero">
    <div class="wrap">
      <span class="eyebrow">My Journey</span>
      <h1>信仰历程</h1>
      <p class="lead">把神一步一步带领我的脚踪记下来，免得忘记。</p>
    </div>
  </header>
  <div class="wrap">
    <blockquote class="pinned">
      <span class="pin-label">置顶经文</span>
      <p class="zh">爱是恒久忍耐，又有恩慈；爱是不嫉妒；爱是不自夸，不张狂，不做害羞的事，不求自己的益处，不轻易发怒，不计算人的恶，不喜欢不义，只喜欢真理；凡事包容，凡事相信，凡事盼望，凡事忍耐。</p>
      <p class="en">Charity suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up, doth not behave itself unseemly, seeketh not her own, is not easily provoked, thinketh no evil; rejoiceth not in iniquity, but rejoiceth in the truth; beareth all things, believeth all things, hopeth all things, endureth all things.</p>
      <cite>哥林多前书 13:4-7</cite>
    </blockquote>
    <ol class="timeline journey">
      {JOURNEY.map((n) => (
        <li>
          <div class="meta"><span class="when">{n.when}</span></div>
          <h3>{n.title}</h3>
          <p>{n.text}</p>
          {n.verse && (
            <blockquote class="jv">
              <p class="zh">{n.verse.zh}</p>
              <p class="en">{n.verse.en}</p>
              <cite>{n.verse.ref}</cite>
            </blockquote>
          )}
          {n.link && <p class="jl"><a href={n.link.href}>{n.link.label} →</a></p>}
        </li>
      ))}
    </ol>
    <p class="journey-end">未完待续。愿神继续带领前面的路。</p>
  </div>
</Base>

<style>
  .pinned { margin: 32px 0 0; padding: 22px 22px 18px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--accent); }
  .pinned .pin-label { display: inline-block; font-size: 0.78rem; font-weight: 600; color: var(--accent); letter-spacing: 0.04em; margin-bottom: 8px; }
  .pinned .zh { margin: 0; font-family: 'Noto Serif SC', serif; font-size: 1.12rem; line-height: 1.9; }
  .pinned .en { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.7; }
  .pinned cite { display: block; margin-top: 10px; font-style: normal; font-size: 0.88rem; color: var(--muted); text-align: right; }
  .journey { margin-top: 36px; }
  .journey li { padding-bottom: 34px; }
  .when { font-size: 0.85rem; font-weight: 600; color: var(--accent); letter-spacing: 0.02em; }
  .journey p { color: var(--text); font-size: 1rem; line-height: 1.75; }
  .jv { margin: 12px 0 0; padding: 12px 16px; border-left: 3px solid var(--accent); background: var(--surface); border-radius: 0 10px 10px 0; }
  .jv p { margin: 0; }
  .jv .zh { font-family: 'Noto Serif SC', serif; }
  .jv .en { color: var(--muted); font-size: 0.9rem; margin-top: 4px; }
  .jv cite { display: block; margin-top: 6px; font-style: normal; font-size: 0.85rem; color: var(--muted); }
  .jl { margin-top: 8px !important; }
  .journey-end { color: var(--muted); text-align: center; margin: 8px 0 48px; }
</style>
