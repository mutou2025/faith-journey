---
import Base from '../layouts/Base.astro';
import GenIcon from '../components/GenIcon.astro';
import { SECTIONS, VERDICT_LABEL, WOMEN, TIPS, BEFORE_ABRAHAM, COMPARE, type Person } from '../genealogy';
import { parseRef, refHref } from '../bible/ref';
import { CUV } from '../bible/data';

const link = (ref: string) => {
  const r = parseRef(ref);
  if (!r) throw new Error(`无法解析经文出处：${ref}`);
  return refHref(r);
};
const pretty = (ref: string) => {
  const r = parseRef(ref);
  if (!r) return ref;
  if (!r.verse) return `${r.book.name} ${r.chapter} 章`;
  return `${r.book.name} ${r.chapter}:${r.verse}${r.verseEnd ? `-${r.verseEnd}` : ''}`;
};

// 路加 3:23-38：构建时直接从和合本取出“X是Y的儿子”里的名字
const lukeText = CUV[41][2].slice(22, 38).join('');
const LUKE = ['耶稣', ...[...lukeText.matchAll(/([^；，。\s]+?)是([^；，。]+?)的儿子/g)].map((m) => m[2])];
const BEFORE = new Set(BEFORE_ABRAHAM.map((b) => b.name));
const dIdx = LUKE.indexOf('大卫'), aIdx = LUKE.indexOf('亚伯拉罕');
const inMatt = (n: string, i: number) => n === '撒拉铁' || n === '所罗巴伯' || (i >= dIdx && i <= aIdx);

// 每段的名字顺序（记忆练习用）
const order = SECTIONS.map((s) => ({
  id: s.id,
  title: `第${'一二三'[s.no - 1]}段 · ${s.span}`,
  names: [...s.people.map((p) => p.name), ...(s.namesOnly?.names ?? []), ...(s.after ?? []).map((p) => p.name)],
}));
---
<Base
  title="耶稣基督的家谱图解：三个十四代，每个人身上发生了什么"
  description="用简笔画图解马太福音 1 章耶稣基督的家谱：从亚伯拉罕到大卫、从大卫到被掳巴比伦、从被掳到基督的三个十四代，每位人物的主要事迹附和合本出处；还有家谱中的五位女性、马太与路加家谱对照，以及按顺序记名字的小练习。"
  keywords={['耶稣家谱', '耶稣基督的家谱', '马太福音1章', '路加福音3章', '三个十四代', '大卫的子孙', '家谱中的女性', '圣经人物']}
>
  <header class="page-hero">
    <div class="wrap">
      <span class="eyebrow">The Genealogy of Jesus Christ</span>
      <h1>耶稣基督的家谱</h1>
      <p class="lead">新约的第一页是一串名字：“亚伯拉罕生以撒，以撒生雅各……”。看起来枯燥，其实每个名字背后都有一段故事，有信心也有失败。这里用简笔画把马太福音 1 章的家谱画成一条路，点开每个人，就能看到他身上发生了什么，经文出处都可以直接点开阅读。</p>

      <figure class="map" aria-labelledby="mapCap">
        <svg viewBox="0 0 360 200" role="img" aria-label="三个十四代的路线图：从亚伯拉罕上坡到大卫，下坡到巴比伦，再上坡到基督">
          <path class="map-road" d="M22 160 C 60 150, 90 50, 128 44 C 168 40, 200 160, 240 162 C 280 164, 300 60, 338 40" />
          <path class="map-road-dash" d="M22 160 C 60 150, 90 50, 128 44 C 168 40, 200 160, 240 162 C 280 164, 300 60, 338 40" />
          <g transform="translate(2 120) scale(0.8)"><GenIcon name="tent" /></g>
          <g transform="translate(108 0) scale(0.8)"><GenIcon name="harp" /></g>
          <g transform="translate(222 168) scale(0.55)"><GenIcon name="chains" /></g>
          <g transform="translate(318 0) scale(0.8)"><GenIcon name="star" /></g>
          <text x="24" y="190" class="map-name">亚伯拉罕</text>
          <text x="148" y="30" class="map-name">大卫</text>
          <text x="254" y="190" class="map-name">迁至巴比伦</text>
          <text x="314" y="24" class="map-name" text-anchor="end">基督</text>
          <g class="map-14"><circle cx="78" cy="100" r="13" /><text x="78" y="105">14</text></g>
          <g class="map-14"><circle cx="186" cy="104" r="13" /><text x="186" y="109">14</text></g>
          <g class="map-14"><circle cx="292" cy="112" r="13" /><text x="292" y="117">14</text></g>
        </svg>
        <figcaption id="mapCap">一上、一下、再一上：<b>应许</b>一路走到大卫的宝座，<b>王国</b>一路滑到被掳，在<b>等候</b>中迎来基督。（太 1:17）</figcaption>
      </figure>

      <nav class="jump" aria-label="跳到">
        <a href="#frame">先记大框架</a>
        {SECTIONS.map((s) => <a href={`#${s.id}`}>第{'一二三'[s.no - 1]}段</a>)}
        <a href="#women">五位女性</a>
        <a href="#luke">马太和路加</a>
        <a href="#practice">记忆练习</a>
      </nav>
    </div>
  </header>

  <div class="wrap gen">
    <section class="section" id="frame">
      <div class="section-head"><div><h2>先记住大框架</h2><p>马太自己把家谱分成三段，每段十四代（太 1:17）。先记住三个关键词和四个转折点，名字就有了挂的地方。</p></div></div>
      <ol class="frame">
        {SECTIONS.map((s) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="f-no">{s.no}</span>
              <span class="f-word">{s.title}</span>
              <span class="f-span">{s.span}</span>
              <span class="f-theme">{s.theme}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="tips">
        {TIPS.map((t) => (
          <details class="tip">
            <summary>{t.title}</summary>
            <p>{t.body}</p>
          </details>
        ))}
      </div>
      <p class="tools">
        <button type="button" class="btn ghost small" id="openAll">全部展开</button>
        <a class="btn ghost small" href={link('太1')}>读马太福音 1 章原文</a>
      </p>
    </section>

    {SECTIONS.map((s, si) => (
      <section class="section part" id={s.id}>
        <div class="part-head">
          <span class="part-no">第{'一二三'[s.no - 1]}段 · 14 代</span>
          <h2>{s.title}<small>{s.span}</small></h2>
          <p>{s.intro}</p>
          <p class="rhyme"><span>顺口溜</span>{s.rhyme}</p>
          {s.no === 2 && (
            <p class="legend">
              <span><i class="v good"></i>行正</span><span><i class="v bad"></i>行恶</span><span><i class="v mixed"></i>先好后偏</span><span><i class="v repent"></i>后来悔改</span>
            </p>
          )}
        </div>
        <ol class="line" start="1">
          {[...s.people].map((p: Person, pi) => (
            <li class="node">
              <details class="p" data-p>
                <summary>
                  <span class="p-icon"><GenIcon name={p.icon} size={40} /></span>
                  <span class="p-main">
                    <span class="p-name"><span class="p-n">{pi + 1}</span>{p.name}{p.aside && <small>{p.aside}</small>}
                      {p.verdict && <i class:list={['v', p.verdict]} title={VERDICT_LABEL[p.verdict]}></i>}
                      {p.mother && <span class="p-mom">母 · {p.mother.name}</span>}
                    </span>
                    <span class="p-tag">{p.tag}</span>
                  </span>
                </summary>
                <div class="p-body">
                  {p.verdict && <p class="p-verdict">圣经的评价：{VERDICT_LABEL[p.verdict]}</p>}
                  <ul>{p.events.map((e) => <li>{e}</li>)}</ul>
                  <p class="refs"><span class="refs-label">经文</span>{p.refs.map((r) => <a href={link(r)}>{pretty(r)}</a>)}</p>
                  {p.mother && (
                    <div class="mom">
                      <span class="mom-icon"><GenIcon name={p.mother.icon} size={36} /></span>
                      <div>
                        <p class="mom-title">家谱中的女性 · {p.mother.name}<span>{p.mother.tag}</span></p>
                        <ul>{p.mother.events.map((e) => <li>{e}</li>)}</ul>
                        <p class="refs"><span class="refs-label">经文</span>{p.mother.refs.map((r) => <a href={link(r)}>{pretty(r)}</a>)}</p>
                      </div>
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
          {s.namesOnly && (
            <li class="node">
              <div class="p p-quiet">
                <span class="p-icon"><GenIcon name="name" size={40} /></span>
                <div class="p-main">
                  <span class="p-name"><span class="p-n">{s.people.length + 1}–{s.people.length + s.namesOnly.names.length}</span>只留下名字的九个人</span>
                  <span class="names">{s.namesOnly.names.map((n, i) => <span>{n}{(i + 1) % 3 === 0 && i < 8 && <b aria-hidden="true">｜</b>}</span>)}</span>
                  <span class="p-tag">{s.namesOnly.note}</span>
                  <p class="refs"><span class="refs-label">经文</span><a href={link('太1:13-15')}>{pretty('太1:13-15')}</a></p>
                </div>
              </div>
            </li>
          )}
          {(s.after ?? []).map((p, ai) => (
            <li class:list={['node', { jesus: p.name === '耶稣' }]}>
              <details class="p" data-p open={p.name === '耶稣' ? true : undefined}>
                <summary>
                  <span class="p-icon"><GenIcon name={p.icon} size={40} /></span>
                  <span class="p-main">
                    <span class="p-name"><span class="p-n">{s.people.length + (s.namesOnly?.names.length ?? 0) + ai + 1}</span>{p.name}
                      {p.mother && <span class="p-mom">母 · {p.mother.name}</span>}
                    </span>
                    <span class="p-tag">{p.tag}</span>
                  </span>
                </summary>
                <div class="p-body">
                  <ul>{p.events.map((e) => <li>{e}</li>)}</ul>
                  <p class="refs"><span class="refs-label">经文</span>{p.refs.map((r) => <a href={link(r)}>{pretty(r)}</a>)}</p>
                  {p.mother && (
                    <div class="mom">
                      <span class="mom-icon"><GenIcon name={p.mother.icon} size={36} /></span>
                      <div>
                        <p class="mom-title">家谱中的女性 · {p.mother.name}<span>{p.mother.tag}</span></p>
                        <ul>{p.mother.events.map((e) => <li>{e}</li>)}</ul>
                        <p class="refs"><span class="refs-label">经文</span>{p.mother.refs.map((r) => <a href={link(r)}>{pretty(r)}</a>)}</p>
                      </div>
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="section" id="women">
      <div class="section-head"><div><h2>家谱里的五位女性</h2><p>古代家谱通常只记男人，马太却特别写进五位女性，而且多半不是“体面”的人选：有外邦人，有不光彩的过去。神的恩典偏偏从这些地方走过去。</p></div></div>
      <div class="women">
        {WOMEN.map((w, i) => (
          <a class="woman" href={link(w.ref)}>
            <span class="w-no">{i + 1}</span>
            <span class="w-name">{w.name}</span>
            <span class="w-who">{w.who}</span>
            <span class="w-point">{w.point}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="luke">
      <div class="section-head"><div><h2>马太和路加：两份家谱</h2><p>路加福音 3 章还有一份耶稣的家谱。两份在大卫之前几乎一样，大卫之后却走了两条线，到约瑟那里又会合。</p></div></div>

      <figure class="branches">
        <svg viewBox="0 0 340 300" role="img" aria-label="大卫之后分成两条线：马太经所罗门，路加经拿单，两条线在撒拉铁和所罗巴伯相交，最后都到约瑟和耶稣">
          <g class="br-m">
            <path d="M170 34 C 130 55, 100 70, 100 100 L 100 132 C 100 150, 150 150, 160 166 C 150 184, 100 186, 100 206 L 100 236 C 100 256, 150 256, 170 266" />
          </g>
          <g class="br-l">
            <path d="M170 34 C 210 55, 240 70, 240 100 L 240 132 C 240 150, 190 150, 180 166 C 190 184, 240 186, 240 206 L 240 236 C 240 256, 190 256, 170 266" />
          </g>
          <g class="br-node"><circle cx="170" cy="28" r="18" /><text x="170" y="33">大卫</text></g>
          <text class="br-lab m" x="92" y="108" text-anchor="end">所罗门</text>
          <text class="br-sub" x="92" y="126" text-anchor="end">众王 ··· 耶哥尼雅</text>
          <text class="br-lab l" x="248" y="108" text-anchor="start">拿单</text>
          <text class="br-sub" x="248" y="126" text-anchor="start">玛达他 ··· 尼利</text>
          <g class="br-node"><rect x="104" y="151" width="132" height="32" rx="16" /><text x="170" y="172">撒拉铁 · 所罗巴伯</text></g>
          <text class="br-lab m" x="92" y="226" text-anchor="end">亚比玉 ··· 雅各</text>
          <text class="br-lab l" x="248" y="226" text-anchor="start">利撒 ··· 希里</text>
          <g class="br-node"><circle cx="170" cy="272" r="20" /><text x="170" y="270" class="sm">约瑟</text><text x="170" y="284" class="sm">耶稣</text></g>
          <text class="br-key m" x="10" y="290">马太</text>
          <text class="br-key l" x="330" y="290" text-anchor="end">路加</text>
        </svg>
        <figcaption>两份家谱都经过被掳时期的撒拉铁和所罗巴伯，最后都说到约瑟和耶稣。</figcaption>
      </figure>

      <div class="cmp" role="table" aria-label="马太与路加家谱对照">
        <div class="cmp-row cmp-h" role="row"><span role="columnheader"></span><span role="columnheader">马太福音 1 章</span><span role="columnheader">路加福音 3 章</span></div>
        {COMPARE.map(([k, m, l]) => (
          <div class="cmp-row" role="row"><span class="cmp-k" role="rowheader">{k}</span><span role="cell" data-label="马太">{m}</span><span role="cell" data-label="路加">{l}</span></div>
        ))}
      </div>

      <details class="tip why">
        <summary>为什么约瑟的父亲一个是雅各、一个是希里？</summary>
        <p>圣经没有直接说明，历代常见两种看法：</p>
        <ul>
          <li><b>路加写的是马利亚的家谱。</b>希里是马利亚的父亲，约瑟是他的女婿，按当时的习惯也可称“儿子”。路加的降生故事本来就多从马利亚的角度写，而且他特别说耶稣“依人看来，是约瑟的儿子”。</li>
          <li><b>两份都是约瑟的家谱。</b>马太写的是王位的、法律上的继承，路加写的是血缘上的；中间可能有过“兄死无子，弟娶嫂为兄立后”的情形，所以同一个人会有两位“父亲”。</li>
        </ul>
        <p>无论哪一种，两份家谱都见证同一件事：耶稣是大卫的后裔，是神应许的那一位。</p>
        <p class="refs"><span class="refs-label">经文</span><a href={link('路3:23')}>{pretty('路3:23')}</a><a href={link('申25:5-6')}>{pretty('申25:5-6')}</a><a href={link('路1:32')}>{pretty('路1:32')}</a></p>
      </details>

      <h3 class="sub">路加一直往上写到亚当</h3>
      <p class="muted">马太从亚伯拉罕开始，路加越过亚伯拉罕，一直写到“亚当是神的儿子”。紧接着就是耶稣在旷野受试探：第一个亚当失败的地方，末后的亚当得胜了。</p>
      <div class="before">
        {BEFORE_ABRAHAM.map((b) => (
          <a class="b-card" href={link(b.ref)}>
            <span class="b-icon"><GenIcon name={b.icon} size={36} /></span>
            <span class="b-name">{b.name}</span>
            <span class="b-ev">{b.event}</span>
            <span class="b-ref">{pretty(b.ref)}</span>
          </a>
        ))}
      </div>

      <details class="tip all-luke">
        <summary>路加家谱的全部名字（从耶稣往上）</summary>
        <p class="legend">
          <span><i class="dot both"></i>马太家谱里也有</span><span><i class="dot before"></i>亚伯拉罕之前（上面画了的）</span>
        </p>
        <ol class="luke-list">
          {LUKE.map((n, i) => (
            <li class:list={{ both: inMatt(n, i), before: BEFORE.has(n), god: n === '神' }}>{n}</li>
          ))}
        </ol>
        <p class="refs"><span class="refs-label">经文</span><a href={link('路3:23-38')}>{pretty('路3:23-38')}</a></p>
      </details>
    </section>

    <section class="section" id="practice">
      <div class="section-head"><div><h2>记忆练习：按顺序点名字</h2><p>名字被打乱了，按家谱顺序一个个点出来。点对了会排进上面的队伍，点错了会抖一下。先看一遍上面的顺口溜再试试。</p></div></div>
      <div class="game" id="game" data-order={JSON.stringify(order)}>
        <div class="g-tabs" role="tablist">
          {order.map((o, i) => <button type="button" role="tab" data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>第{'一二三'[i]}段</button>)}
        </div>
        <p class="g-title" id="gTitle"></p>
        <ol class="g-done" id="gDone" aria-live="polite"></ol>
        <div class="g-pool" id="gPool"></div>
        <p class="g-msg" id="gMsg" aria-live="polite"></p>
        <p class="g-actions">
          <button type="button" class="btn ghost small" id="gHint">提示下一个</button>
          <button type="button" class="btn ghost small" id="gReset">重新打乱</button>
        </p>
      </div>
    </section>

    <section class="section">
      <p class="more">家谱读完，可以接着看：<a href="/basics/#ot">常识问答 · 旧约人物</a> · <a href="/basics/#nt">新约人物</a> · <a href={link('太1')}>马太福音 1 章</a> · <a href={link('路3')}>路加福音 3 章</a> · <a href={link('得4')}>路得记 4 章（大卫的家谱）</a> · <a href="/gospel/">认识福音</a></p>
    </section>
  </div>
</Base>

<script>
  // 全部展开 / 收起
  const btn = document.getElementById('openAll');
  const ps = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-p]'));
  btn?.addEventListener('click', () => {
    const open = btn.textContent === '全部展开';
    ps.forEach((d) => (d.open = open));
    btn.textContent = open ? '全部收起' : '全部展开';
  });

  // 记忆练习
  const game = document.getElementById('game');
  if (game) {
    const order = JSON.parse(game.dataset.order!) as { id: string; title: string; names: string[] }[];
    const tabs = Array.from(game.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const title = document.getElementById('gTitle')!;
    const done = document.getElementById('gDone')!;
    const pool = document.getElementById('gPool')!;
    const msg = document.getElementById('gMsg')!;
    let cur = 0;
    let next = 0;
    let misses = 0;
    const shuffle = <T,>(a: T[]) => {
      const b = a.slice();
      for (let i = b.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [b[i], b[j]] = [b[j], b[i]];
      }
      return b;
    };
    const start = (i: number) => {
      cur = i; next = 0; misses = 0;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      const o = order[i];
      title.textContent = `${o.title}（共 ${o.names.length} 个名字）`;
      done.innerHTML = '';
      msg.textContent = '';
      pool.innerHTML = '';
      shuffle(o.names.map((n, k) => ({ n, k }))).forEach(({ n, k }) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = n;
        b.dataset.k = String(k);
        pool.appendChild(b);
      });
    };
    const place = (b: HTMLButtonElement) => {
      const li = document.createElement('li');
      li.textContent = b.textContent;
      done.appendChild(li);
      b.remove();
      next++;
      const o = order[cur];
      if (next === o.names.length) {
        msg.textContent = misses === 0 ? '太好了，一次都没错！' : `完成了！中间点错了 ${misses} 次，再来一遍会更熟。`;
      } else msg.textContent = '';
    };
    pool.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const name = order[cur].names[next];
      // 同名的人（如两个“雅各”）任点一个都算对
      if (b.textContent === name) place(b as HTMLButtonElement);
      else {
        misses++;
        b.classList.remove('shake');
        void b.offsetWidth;
        b.classList.add('shake');
        msg.textContent = '不对哦，再想想上面的顺口溜。';
      }
    });
    document.getElementById('gHint')!.addEventListener('click', () => {
      const name = order[cur].names[next];
      const b = Array.from(pool.querySelectorAll('button')).find((x) => x.textContent === name);
      if (b) { b.classList.add('hint'); setTimeout(() => b.classList.remove('hint'), 1200); }
    });
    document.getElementById('gReset')!.addEventListener('click', () => start(cur));
    tabs.forEach((t, k) => t.addEventListener('click', () => start(k)));
    start(0);
  }
