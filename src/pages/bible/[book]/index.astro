---
import Base from '../../../layouts/Base.astro';
import BibleSearch from '../../../components/bible/BibleSearch.astro';
import { BOOKS, type Book } from '../../../bible/books';
import { CUV } from '../../../bible/data';

export function getStaticPaths() {
  return BOOKS.map((book, i) => ({ params: { book: book.slug }, props: { book, index: i } }));
}
const { book, index } = Astro.props as { book: Book; index: number };
const prev = BOOKS[index - 1];
const next = BOOKS[index + 1];
const verseCount = CUV[index].reduce((n, c) => n + c.length, 0);
const unit = book.slug === 'psa' ? '篇' : '章';
---
<Base
  title={`${book.name}（和合本）`}
  description={`${book.name}（${book.en}）和合本全文，共 ${book.chapters} ${unit}，按章阅读。`}
  keywords={[book.name, `${book.name}和合本`, book.en]}
>
  <header class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="位置"><a href="/bible/">圣经</a> / {book.testament === 'OT' ? '旧约' : '新约'} · {book.group}</nav>
      <h1>{book.name}</h1>
      <p class="lead">{book.en} · 共 {book.chapters} {unit}、{verseCount} 节 · 简称“{book.abbr}”</p>
      <BibleSearch />
    </div>
  </header>

  <div class="wrap">
    <h2 class="pick">选择{unit === '篇' ? '篇' : '章'}</h2>
    <div class="ch-grid">
      {Array.from({ length: book.chapters }, (_, i) => <a href={`/bible/${book.slug}/${i + 1}/`}>{i + 1}</a>)}
    </div>
    <nav class="book-pager">
      {prev ? <a href={`/bible/${prev.slug}/`}>← {prev.name}</a> : <span></span>}
      {next ? <a href={`/bible/${next.slug}/`}>{next.name} →</a> : <span></span>}
    </nav>
  </div>
</Base>

<style>
  .crumbs { font-size: 0.88rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .pick { font-size: 1.05rem; margin: 36px 0 14px; color: var(--muted); font-weight: 600; }
  .ch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(52px, 1fr)); gap: 8px; }
  .ch-grid a {
    display: grid; place-items: center; height: 46px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line);
    text-decoration: none; color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .ch-grid a:hover { border-color: var(--accent); color: var(--accent); }
  .book-pager { display: flex; justify-content: space-between; margin-top: 36px; font-weight: 600; }
  .book-pager a { text-decoration: none; }
</style>
